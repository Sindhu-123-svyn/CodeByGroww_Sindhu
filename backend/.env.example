# Local dev only — postgres/postgres is a documented shortcut for the local
# smart-market-db Docker container, never for a shared/deployed environment.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_market_watchlist
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=60

INGESTION_INTERVAL_OPEN_SECONDS=30
INGESTION_INTERVAL_OFFHOURS_SECONDS=900
STALENESS_THRESHOLD_MINUTES=5
BASELINE_MIN_SAMPLE_SIZE=10
